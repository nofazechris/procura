# ---------------------------------------------------------------------------
# Procura environment. Copy to .env (never commit it). Server-side only unless NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Neon Postgres (replaces Supabase)
# App runtime: Neon *pooled* connection string for the NON-OWNER role `procura_app`.
# Row Level Security only protects tenants when the app connects as this role.
DATABASE_URL=postgresql://procura_app:***@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Migrations only: Neon *direct* (unpooled) string for the schema owner role.
MIGRATION_DATABASE_URL=postgresql://neondb_owner:***@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Authentication (Better Auth, self-hosted). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Set to "false" only for local development without an email provider.
REQUIRE_EMAIL_VERIFICATION=true

# Demo only. Treat 1 USD as 1 USDC.e when creating purchase orders. There is no market-rate feed,
# so leave this "false" in production: orders then fail safely instead of guessing a rate.
ALLOW_FIXED_USD_PEG=false
# Controlled testnet wallet that demo suppliers propose as their payout address (0x + 40 hex).
DEMO_RECIPIENT_ADDRESS=

# ERC-20 used for escrow and payments on Kite (0x + 40 hex). Not in the Kite docs; set it once confirmed.
# Wallet balances show the native token only until this is set.
PAYMENT_TOKEN_ADDRESS=

# --- Later phases (not used yet) -------------------------------------------
# SERV Reasoning (https://docs.openserv.ai/serv-reasoning/api). Key from https://console.openserv.ai.
# Model ids are listed at https://docs.openserv.ai/serv-reasoning/models.
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai
SERV_MODEL=gpt-5.4-mini
# Kite Passport (https://docs.gokite.ai/passport/install). No HTTP API exists: Procura drives the kpass CLI.
# KPASS_BIN: path to kpass. PASSPORT_HOME: folder holding its .kite-passport login (gitignored, holds a token).
# PASSPORT_BUSINESS_ID: the one business allowed to use that login (one login must not serve several tenants).
KPASS_BIN=kpass
PASSPORT_HOME=
PASSPORT_BUSINESS_ID=
KITE_ENVIRONMENT=
KITE_RUNTIME_CONFIG=
# Worker
REDIS_URL=
WORKER_SECRET=
# Monitoring
ERROR_MONITORING_DSN=
