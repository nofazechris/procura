{
  "name": "procura",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @procura/web dev",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:db:reset": "node scripts/dev-db.mjs --reset",
    "build": "pnpm --filter @procura/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @procura/database generate",
    "db:migrate": "pnpm --filter @procura/database migrate"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@neondatabase/serverless": "^1.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.3.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.23.1",
    "typescript": "~5.9.3",
    "viem": "^2.57.16",
    "vitest": "^3.2.4"
  }
}
